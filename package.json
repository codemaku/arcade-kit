{
  "name": "@codemaku/arcade",
  "version": "0.1.0",
  "description": "Shared pixel-arcade design system, runtime helpers, and Vite preset for Codemaku games.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./style.css": "./src/style.css",
    "./vite": {
      "types": "./types/vite.d.ts",
      "import": "./src/vite.js"
    }
  },
  "bin": {
    "arcade-obfuscate": "./bin/arcade-obfuscate.mjs"
  },
  "files": [
    "src",
    "types",
    "bin",
    "KIT.md",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/vite.js && node --check bin/arcade-obfuscate.mjs",
    "prepublishOnly": "npm run check",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "dependencies": {
    "javascript-obfuscator": "^4.1.1",
    "terser": "^5.36.0",
    "vite-plugin-singlefile": "^2.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "vite": "^6.0.7"
  }
}
